# ---------------------------------------------------------------------------
# Tennis Truth Engine — runtime environment
#
# Everything the application needs, and nothing it does not. There is no
# Supabase project ref, no anon or service-role key, and no Lovable key: the
# app reaches PostgreSQL directly and the browser holds no credential at all.
# ---------------------------------------------------------------------------

# REQUIRED. The database. On Replit this is provided by the postgresql-16
# module; anywhere else, any PostgreSQL 14+ connection string works.
DATABASE_URL=postgresql://user:password@host:5432/database

# Optional. Maximum pooled connections per application instance (default 10).
# DATABASE_POOL_MAX=10

# ---------------------------------------------------------------------------
# Research provider (optional)
#
# The audit pipeline is warehouse-first and deterministic; this is the last
# tier, used only for metrics no deterministic producer could resolve. With
# nothing configured, those metrics resolve UNAVAILABLE rather than guessed --
# which is the intended behaviour, not a degradation.
#
# Any OpenAI-compatible chat-completions endpoint works.
# ---------------------------------------------------------------------------
# RESEARCH_API_KEY=
# RESEARCH_URL=https://api.openai.com/v1
# RESEARCH_MODEL=gpt-4o-mini

# Set to "true" ONLY if the endpoint above understands the Gemini-style
# "google_search" grounding tool. Sending it to a plain OpenAI-compatible
# endpoint is a guaranteed 400 on every grounded call.
# RESEARCH_GROUNDED_SEARCH=false

# Second provider, tried when the first fails (credits, rate limit, timeout).
# RESEARCH_FALLBACK_API_KEY=
# RESEARCH_FALLBACK_URL=
# RESEARCH_FALLBACK_MODEL=
# RESEARCH_FALLBACK_GROUNDED_SEARCH=false

# Vision extraction for image-only PDFs — the last tier, reached only after
# embedded-text extraction and on-device OCR both find nothing. Needs a model
# that accepts a PDF file part. Falls back to RESEARCH_* then OPENAI_* if unset.
# RESEARCH_VISION_API_KEY=
# RESEARCH_VISION_URL=
# RESEARCH_VISION_MODEL=

# Shorthand: setting these alone configures the fallback provider against
# api.openai.com without naming a URL.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# OPENAI_MODEL=

# ---------------------------------------------------------------------------
# Audit driver (optional)
#
# scripts/drive-audit-worker.ts keeps RUNNING audits advancing when no browser
# tab is open. Run it as a Replit Scheduled Deployment (RUN_ONCE=true) or as a
# Reserved VM. It claims work through the same database leases the browser and
# API paths use, so running it alongside them cannot double-process a run.
# ---------------------------------------------------------------------------
# AUDIT_DRIVER_INTERVAL_MS=300000
# RUN_ONCE=false

# Shared secret for POST /api/drive-audit-batch, if you drive audits by HTTP
# from an external scheduler instead.
# AUDIT_CRON_SECRET=
