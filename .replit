modules = ["nodejs-22", "python-3.12", "web", "postgresql-16"]

[nix]
channel = "stable-25_05"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5173
externalPort = 5173

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 19024
externalPort = 3001

[[ports]]
localPort = 20235
externalPort = 3000

[workflows]
runButton = "artifacts/tennis-predictor: web"

[[workflows.workflow]]
name = "prediction-worker: paper trading"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/prediction-worker run paper-trading"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "prediction-worker: calibration refit"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/prediction-worker run calibration-refit"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "prediction-worker: historical backfill"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/prediction-worker run historical-backfill"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "typecheck"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm run typecheck"

[workflows.workflow.metadata]
isValidation = true
outputType = "console"

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 180000

[userenv]

[userenv.development]
ENABLE_PARLAY_BUILDER_PAPER_TRADING_SCHEDULER = "true"
